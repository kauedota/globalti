# Copie este arquivo para .env e ajuste os valores.
# Os valores abaixo são só exemplos para desenvolvimento local.

DB_NAME=prova
DB_USER=prova
DB_PASSWORD=troque-esta-senha
DB_PORT=5432

# Segredo do JWT: use uma frase longa (mínimo 32 caracteres).
JWT_SECRET=troque-este-segredo-por-uma-frase-bem-longa-e-aleatoria
# Tempo de vida do token, em minutos.
JWT_EXPIRATION_MINUTES=120

# Admin criado na primeira vez que a API sobe.
ADMIN_EMAIL=admin@globalti.com.br
ADMIN_PASSWORD=Admin@123
